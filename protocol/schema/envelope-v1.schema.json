{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s3-rlcd-deck.local/schema/envelope-v1.schema.json",
  "title": "S3 RLCD Deck control message envelope v1",
  "type": "object",
  "required": [
    "type",
    "protocol_version"
  ],
  "properties": {
    "type": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,31}(\\.[a-z][a-z0-9_]{0,31})+$"
    },
    "protocol_version": {
      "const": 1
    }
  },
  "additionalProperties": true,
  "x-maximum-encoded-bytes": 16384,
  "x-duplicate-object-keys": "rejected"
}

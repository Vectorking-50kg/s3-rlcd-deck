{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s3-rlcd-deck.local/schema/device-link-v1.schema.json",
  "title": "S3 RLCD Deck Device Link control messages v1",
  "oneOf": [
    {"$ref": "#/$defs/device_hello"},
    {"$ref": "#/$defs/device_heartbeat"},
    {"$ref": "#/$defs/serial_state"},
    {"$ref": "#/$defs/serial_owner_request"},
    {"$ref": "#/$defs/serial_owner_result"},
    {"$ref": "#/$defs/serial_owner_activity"},
    {"$ref": "#/$defs/serial_history_request"},
    {"$ref": "#/$defs/ota_offer"},
    {"$ref": "#/$defs/ota_chunk"},
    {"$ref": "#/$defs/ota_result"},
    {"$ref": "#/$defs/diagnostics_request"},
    {"$ref": "#/$defs/diagnostics_snapshot"}
  ],
  "$defs": {
    "device_hello": {
      "type": "object",
      "required": ["type", "protocol_version", "device_id", "firmware_version", "board", "capabilities", "serial_state", "serial_session_id"],
      "properties": {
        "type": {"const": "device.hello"},
        "protocol_version": {"const": 1},
        "device_id": {"type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9_-]{7,63}$"},
        "firmware_version": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,31}$"},
        "board": {"const": "esp32-s3-rlcd-4.2"},
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"enum": ["display", "serial", "ota", "diagnostics"]}
        },
        "serial_state": {"enum": ["disarmed", "usb_tx", "web_tx"]},
        "serial_session_id": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"serial_state": {"const": "disarmed"}}},
          "then": {"properties": {"serial_session_id": {"const": 0}}},
          "else": {
            "properties": {
              "serial_session_id": {"minimum": 1},
              "capabilities": {"contains": {"const": "serial"}}
            }
          }
        }
      ]
    },
    "serial_state": {
      "type": "object",
      "required": ["type", "protocol_version", "serial_state", "serial_session_id", "owner_generation", "lease_id"],
      "properties": {
        "type": {"const": "serial.state"},
        "protocol_version": {"const": 1},
        "serial_state": {"enum": ["disarmed", "usb_tx", "web_tx"]},
        "serial_session_id": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "owner_generation": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "lease_id": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
      },
      "additionalProperties": false,
      "oneOf": [
        {"properties": {"serial_state": {"const": "disarmed"}, "serial_session_id": {"const": 0}, "lease_id": {"const": 0}}},
        {"properties": {"serial_state": {"const": "usb_tx"}, "serial_session_id": {"minimum": 1}, "lease_id": {"const": 0}}},
        {"properties": {"serial_state": {"const": "web_tx"}, "serial_session_id": {"minimum": 1}, "lease_id": {"minimum": 1}}}
      ]
    },
    "serial_owner_request": {
      "type": "object",
      "required": ["type", "protocol_version", "serial_session_id", "request_id", "enable"],
      "properties": {
        "type": {"const": "serial.owner.request"},
        "protocol_version": {"const": 1},
        "serial_session_id": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "request_id": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "enable": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "serial_owner_activity": {
      "type": "object",
      "required": ["type", "protocol_version", "serial_session_id", "lease_id"],
      "properties": {
        "type": {"const": "serial.owner.activity"},
        "protocol_version": {"const": 1},
        "serial_session_id": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "lease_id": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}
      },
      "additionalProperties": false
    },
    "serial_history_request": {
      "type": "object",
      "required": ["type", "protocol_version", "serial_session_id", "after_sequence"],
      "properties": {
        "type": {"const": "serial.history.request"},
        "protocol_version": {"const": 1},
        "serial_session_id": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "after_sequence": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
      },
      "additionalProperties": false
    },
    "serial_owner_result": {
      "type": "object",
      "required": ["type", "protocol_version", "serial_session_id", "request_id", "code", "serial_state", "owner_generation", "lease_id"],
      "properties": {
        "type": {"const": "serial.owner.result"},
        "protocol_version": {"const": 1},
        "serial_session_id": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "request_id": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "code": {"enum": ["applied", "no_change", "stale_session", "stale_request", "uart_install_failed", "uart_uninstall_failed", "invalid"]},
        "serial_state": {"enum": ["disarmed", "usb_tx", "web_tx"]},
        "owner_generation": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "lease_id": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
      },
      "additionalProperties": false,
      "oneOf": [
        {"properties": {"serial_state": {"const": "disarmed"}, "serial_session_id": {"const": 0}, "lease_id": {"const": 0}}},
        {"properties": {"serial_state": {"const": "usb_tx"}, "serial_session_id": {"minimum": 1}, "lease_id": {"const": 0}}},
        {"properties": {"serial_state": {"const": "web_tx"}, "serial_session_id": {"minimum": 1}, "lease_id": {"minimum": 1}}}
      ]
    },
    "device_heartbeat": {
      "type": "object",
      "required": ["type", "protocol_version", "utc", "monotonic_ms", "tx_queue_depth", "tx_queue_capacity", "rx_queue_depth", "rx_queue_capacity"],
      "properties": {
        "type": {"const": "device.heartbeat"},
        "protocol_version": {"const": 1},
        "utc": {"type": "string", "format": "date-time"},
        "monotonic_ms": {"type": "integer", "minimum": 0},
        "tx_queue_depth": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "tx_queue_capacity": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "rx_queue_depth": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "rx_queue_capacity": {"type": "integer", "minimum": 1, "maximum": 4294967295}
      },
      "additionalProperties": false
    },
    "ota_offer": {
      "type": "object",
      "required": ["type", "protocol_version", "transaction_id", "version", "board", "image_length", "image_sha256", "signature", "signing_key_id", "minimum_protocol_version"],
      "properties": {
        "type": {"const": "ota.offer"},
        "protocol_version": {"const": 1},
        "transaction_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 31, "pattern": "^[0-9][0-9A-Za-z.+-]{0,30}$"},
        "board": {"const": "esp32-s3-rlcd-4.2"},
        "image_length": {"type": "integer", "minimum": 1, "maximum": 1740800},
        "image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"},
        "signing_key_id": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "minimum_protocol_version": {"type": "integer", "minimum": 1, "maximum": 4294967295}
      },
      "additionalProperties": false
    },
    "ota_chunk": {
      "type": "object",
      "required": ["type", "protocol_version", "transaction_id", "offset", "data", "final"],
      "properties": {
        "type": {"const": "ota.chunk"},
        "protocol_version": {"const": 1},
        "transaction_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "offset": {"type": "integer", "minimum": 0, "maximum": 1740799},
        "data": {"type": "string", "minLength": 4, "maxLength": 4096, "pattern": "^[A-Za-z0-9+/]+={0,2}$"},
        "final": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "ota_result": {
      "type": "object",
      "required": ["type", "protocol_version", "transaction_id", "state", "code", "received_bytes", "image_length"],
      "properties": {
        "type": {"const": "ota.result"},
        "protocol_version": {"const": 1},
        "transaction_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "state": {"enum": ["receiving", "ready_to_reboot", "failed"]},
        "code": {"enum": ["ok", "invalid_manifest", "wrong_board", "incompatible_protocol", "downgrade_rejected", "image_too_large", "signature_rejected", "busy", "stale_offset", "flash_failure", "hash_mismatch", "image_invalid", "timed_out"]},
        "received_bytes": {"type": "integer", "minimum": 0, "maximum": 1740800},
        "image_length": {"type": "integer", "minimum": 0, "maximum": 1740800}
      },
      "additionalProperties": false
    },
    "diagnostics_request": {
      "type": "object",
      "required": ["type", "protocol_version", "request_id"],
      "properties": {
        "type": {"const": "diagnostics.request"},
        "protocol_version": {"const": 1},
        "request_id": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}
      },
      "additionalProperties": false
    },
    "diagnostics_snapshot": {
      "type": "object",
      "required": ["type", "protocol_version", "request_id", "dropped", "events"],
      "properties": {
        "type": {"const": "diagnostics.snapshot"},
        "protocol_version": {"const": 1},
        "request_id": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "dropped": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "events": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["monotonic_ms", "level", "component", "code", "value"],
            "properties": {
              "monotonic_ms": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
              "level": {"enum": ["info", "warning", "error"]},
              "component": {"enum": ["system", "display", "wifi", "setup", "sensor", "device_link", "serial", "ota"]},
              "code": {"enum": ["boot", "ready", "unavailable", "connected", "disconnected", "storage_error", "protocol_error", "timeout", "owner_changed", "update_started", "update_failed", "rollback", "queue_overflow"]},
              "value": {"type": "integer", "minimum": 0, "maximum": 4294967295}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
